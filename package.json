{
  "name": "janata-rust-poc-tooling",
  "private": true,
  "packageManager": "bun@1.3.7",
  "devDependencies": {
    "wrangler": "4.118.0"
  },
  "scripts": {
    "poc:build": "deploy/build-site.sh",
    "worker:dev": "bunx wrangler dev --local --config deploy/wrangler.jsonc",
    "worker:dry-run": "bunx wrangler deploy --dry-run --config deploy/wrangler.jsonc",
    "worker:deploy:preview": "bunx wrangler deploy --config deploy/wrangler.jsonc",
    "worker:deploy:production": "bunx wrangler deploy --config deploy/wrangler.production.jsonc",
    "worker:smoke": "bun deploy/smoke-worker.ts",
    "worker:startup": "deploy/profile-worker.sh"
  }
}
