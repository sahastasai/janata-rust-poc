{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // This configuration is intentionally local-only. Never pass it to deploy.
  "name": "janata-cmrust-poc-auth-local",
  "main": "../crates/worker-api/build/worker/shim.mjs",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "../../deploy/build-worker.sh",
    "cwd": "crates/worker-api",
    "watch_dir": [
      "../crates/worker-api/src",
      "../crates/api-contract/src"
    ]
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "janata-cmrust-poc-auth-local",
      // A syntactically valid placeholder used only by Miniflare local state.
      "database_id": "00000000-0000-0000-0000-000000000001",
      "preview_database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../migrations/auth"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_KDF_LIMITER",
      "namespace_id": "17857974",
      "simple": { "limit": 1200, "period": 60 }
    },
    {
      "name": "AUTH_ACCOUNT_LIMITER",
      "namespace_id": "17857975",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "assets": {
    "directory": "../dist/site",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
