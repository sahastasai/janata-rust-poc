{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "janata-cmrust-poc-worker",
  "main": "../crates/worker-api/build/worker/shim.mjs",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "cmrust.sahasta.com",
      "custom_domain": true,
      "previews_enabled": false
    }
  ],
  "build": {
    "command": "../../deploy/build-worker.sh",
    "cwd": "crates/worker-api",
    "watch_dir": "../crates/worker-api/src"
  },
  "assets": {
    "directory": "../dist/site",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
